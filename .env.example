# The Sanity project the site reads from. Find the id in the project URL at
# sanity.io/manage, or run `npx sanity projects list`. Without these the site
# falls back to lib/placeholder-content.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# The site's own origin, used for canonical URLs, the sitemap and share images.
# Set it once the domain is connected. Unset, Vercel's production URL is used,
# which is right for previews and for the site before it has a domain.
NEXT_PUBLIC_SITE_URL=

# Shared secret for the Sanity publish webhook (see app/api/revalidate).
# Use the same value here and in the webhook's Secret field.
SANITY_REVALIDATE_SECRET=
